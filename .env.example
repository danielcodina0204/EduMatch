# Copia este archivo como .env y completa los valores del proyecto de Supabase
# (Supabase > Project Settings > API Keys). El archivo .env no se versiona.
#
# Usa SOLO la "publishable key" (sb_publishable_...). La secret key salta las
# políticas RLS y nunca debe ir en la app web ni en el APK.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<tu-clave>
